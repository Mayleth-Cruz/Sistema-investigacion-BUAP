# VARIABLES DE ENTORNO - SISTEMA DE INFORMACIÓN PARA LA INVESTIGACIÓN (SI3)
# ============================================================================
# Copia este archivo como .env para personalizar tus credenciales locales

APP_NAME="Sistema Integral de Información para la Investigación"
APP_ENV=development
APP_DEBUG=true

# Configuración de Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=investigacion_db
DB_USER=root
DB_PASS=

# Puerto del Servidor PHP en local
PORT=8000
