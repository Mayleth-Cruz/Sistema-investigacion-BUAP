# ============================================================================
# VARIABLES DE ENTORNO - SISTEMA DE INFORMACIÓN PARA LA INVESTIGACIÓN (SI3)
# ============================================================================
# Copia este archivo como .env para personalizar tus credenciales locales

APP_NAME="Sistema Integral de Información para la Investigación"
APP_ENV=development
# APP_DEBUG=1 muestra errores detallados (solo desarrollo). En producción déjalo en 0.
APP_DEBUG=true

# Orígenes permitidos por CORS, separados por comas (si no se define, se permite "*")
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://mi-dominio.mx

# Ruta alternativa de la base SQLite de respaldo (útil para pruebas con una copia de la BD)
# SI3_SQLITE_PATH=/tmp/si3-pruebas/database.sqlite

# Configuración de Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=investigacion_db
DB_USER=root
DB_PASS=

# Puerto del Servidor PHP en local
PORT=8000
